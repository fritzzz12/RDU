  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Explicitly named final action, with comfortable sizing and visible focus.",
      "html": "<button class=\"ds-primary\">Confirm and save</button>",
      "css": ".ds-primary{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:16px;line-height:1.6;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;min-width:44px;padding:11px 18px;border:1px solid transparent;border-radius:8px;background:var(--teal,#176b77);color:white;font-weight:650;cursor:pointer;}.ds-primary:hover{background:#115b66}.ds-primary:focus-visible{outline:3px solid var(--focus,#09677c);outline-offset:3px;}.ds-primary:disabled{background:#e3e9ed;color:#526274;cursor:not-allowed}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A reversible, clearly labeled action such as editing or returning.",
      "html": "<button class=\"ds-secondary\">Go back and edit</button>",
      "css": ".ds-secondary{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:16px;line-height:1.6;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;min-width:44px;padding:11px 18px;border:1px solid transparent;border-radius:8px;background:var(--teal,#176b77);color:white;font-weight:650;cursor:pointer;background:white;color:#235969;border-color:#8296a7}.ds-secondary:hover{background:#edf3f6}.ds-secondary:focus-visible{outline:3px solid var(--focus,#09677c);outline-offset:3px;}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Visible required indicator, readable input and associated supporting explanation.",
      "html": "<div class=\"ds-field\"><label for=\"ds-title\">Research title <span>(Required)</span></label><input id=\"ds-title\" aria-describedby=\"ds-hint\" placeholder=\"Enter a descriptive title\" required><small id=\"ds-hint\">Use a title that describes the study.</small></div>",
      "css": ".ds-field{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:16px;line-height:1.6;display:grid;gap:8px;max-width:440px;color:#233348}.ds-field label{font-weight:650}.ds-field span,.ds-field small{font-size:14px;color:#536b82}.ds-field input{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:16px;line-height:1.6;padding:11px 13px;min-height:48px;border:1px solid #8296a7;border-radius:6px;min-width:0;color:#233348}.ds-field input:focus-visible{outline:3px solid var(--focus,#09677c);outline-offset:3px;}"
    },
    {
      "name": "Active navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Persistent navy wayfinding with a written, highlighted active destination.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Research navigation\"><button aria-current=\"page\">Research projects</button><button>Submitted documents</button></nav>",
      "css": ".ds-nav{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:16px;line-height:1.6;background:#142b46;padding:16px;max-width:282px;border-radius:8px;display:grid;gap:8px}.ds-nav button{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:16px;line-height:1.6;padding:12px 16px;min-height:48px;border:0;border-radius:8px;background:none;color:#d8e6f1;text-align:left;cursor:pointer}.ds-nav button[aria-current]{background:#2a465f;color:white;font-weight:650}.ds-nav button:hover{background:#29455f}.ds-nav button:focus-visible{outline:3px solid #a8e6ee;outline-offset:3px}"
    },
    {
      "name": "Written status",
      "kind": "chip",
      "refersTo": "status-pending",
      "description": "Status text remains visible without relying on color alone.",
      "html": "<span class=\"ds-status\">Waiting for review</span>",
      "css": ".ds-status{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:16px;line-height:1.6;display:inline-block;font-size:14px;line-height:1.6;font-weight:650;padding:6px 10px;border-radius:5px;background:#fff3d9;color:#795213}"
    },
    {
      "name": "Research panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat white working surface with clear heading and restrained separators.",
      "html": "<section class=\"ds-panel\"><h2>Required documents</h2><p>Upload each required PDF, then wait for your Department Head to review it.</p></section>",
      "css": ".ds-panel{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:16px;line-height:1.6;max-width:560px;padding:24px;border:1px solid #cbd6df;border-radius:12px;background:white;color:#233348}.ds-panel h2{font-size:22px;line-height:1.4;margin:0 0 16px}.ds-panel p{margin:0;color:#536b82}"
    },
    {
      "name": "Research stage",
      "kind": "custom",
      "refersTo": "panel",
      "description": "The selected research stage includes official terminology and a plain-language explanation.",
      "html": "<button class=\"ds-stage\" aria-pressed=\"true\"><span class=\"ds-marker\">1</span><span><small>Current stage</small><b>Conceptualization</b><small>Proposal and initial review</small></span></button>",
      "css": ".ds-stage{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:16px;line-height:1.6;display:flex;gap:12px;align-items:flex-start;text-align:left;padding:20px;border:1px solid #176b77;border-radius:12px;background:#edf5f6;color:#233348;cursor:pointer}.ds-marker{display:flex;align-items:center;justify-content:center;width:36px;height:36px;flex-shrink:0;border-radius:50%;background:#176b77;color:white}.ds-stage b,.ds-stage small{display:block}.ds-stage small{font-size:14px;color:#536b82}.ds-stage b{margin:8px 0;font-size:16px}.ds-stage:focus-visible{outline:3px solid var(--focus,#09677c);outline-offset:3px;}"
    },
    {
      "name": "Review before saving",
      "kind": "custom",
      "refersTo": "review-summary",
      "description": "Entered details can be checked and edited before any mutation is sent.",
      "html": "<section class=\"ds-review\"><h2>Check before saving</h2><p>Nothing is saved until you confirm.</p><dl><dt>Research title</dt><dd>Community early-warning networks</dd></dl><div><button class=\"ds-edit\">Go back and edit</button><button class=\"ds-confirm\">Confirm and create project</button></div></section>",
      "css": ".ds-review{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:16px;line-height:1.6;max-width:620px;padding:24px;border:1px solid #b8cdd8;border-radius:10px;background:#f5f9fa;color:#233348}.ds-review h2{font-size:22px;margin:0 0 16px}.ds-review p{color:#35576b}.ds-review dt{font-weight:650}.ds-review dd{margin:8px 0 24px;overflow-wrap:anywhere}.ds-review>div{display:flex;flex-wrap:wrap;gap:12px}.ds-confirm,.ds-edit{font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:16px;line-height:1.6;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;min-width:44px;padding:11px 18px;border:1px solid transparent;border-radius:8px;background:var(--teal,#176b77);color:white;font-weight:650;cursor:pointer;}.ds-edit{background:white;color:#235969;border-color:#8296a7}.ds-confirm:hover{background:#115b66}.ds-edit:hover{background:#edf3f6}.ds-review button:focus-visible{outline:3px solid var(--focus,#09677c);outline-offset:3px;}"
    }
  ],
  "narrative": {
    "northStar": "Research wayfinding",
    "overview": "Make the next research action understandable without requiring technical knowledge. This user-approved accessibility evolution retains the navy navigation, cool light workspace and teal actions, while replacing the predecessor's tiny type and compact controls with readable text, clear instructions and comfortable spacing.\n\nThe visual language serves people operating a research-management system in everyday office and mobile settings. Familiar controls and task-based labels take priority over novelty. The official research checklist and category names remain intact; short explanations make them easier to use.\n\nThis is provisional prototype styling, not official BukSU/RDU branding. No official university logo, font or color guide was supplied. There are no shipped raster design assets. Evidence is the current `src/styles.css`, `src/main.jsx`, `src/ui.jsx`, approved `accessible-after.html` preview and the accessible-prefixed desktop/mobile screenshots in the local context directory.",
    "keyCharacteristics": [
      "Plain-language navigation and named actions, with every original role-visible feature retained.",
      "Readable working text, quieter supporting information and visible status wording.",
      "Responsive labeled records instead of sideways-scrolling tables or hidden columns.",
      "Guided review, editing and explicit confirmation before sensitive decisions."
    ],
    "rules": [
      {
        "name": "The Evidence State Rule",
        "body": "Keep status wording visible alongside color; an uploaded document is not an approved document.",
        "section": "colors"
      },
      {
        "name": "The Readable Evidence Rule",
        "body": "Never shrink information to fit the screen. Reflow the record and wrap the content instead.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use tone, spacing and hierarchy for normal records; reserve elevation for temporary surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the navy/teal identity while prioritizing readability over compact density.",
      "Do use body-scale text for working information and at least the supporting scale for secondary details.",
      "Do reflow every data field into labeled mobile records rather than hiding or truncating it.",
      "Do keep exact research categories/checklist wording and supplement them with short explanations.",
      "Do show an editable review summary before sensitive saving, with no early mutation.",
      "Do preserve visible keyboard focus, inert background behavior and explicit text labels."
    ],
    "donts": [
      "Don't imply that provisional styling is official university branding or demo signatures are certified signatures.",
      "Don't shrink fields, filenames, feedback or status text to fit narrower screens.",
      "Don't replace saved/API status values or role rules just to simplify their display labels.",
      "Don't equate document upload with approval or monitoring with review authority.",
      "Don't present a failed refresh as an unsaved action after the command already succeeded.",
      "Don't add decorative shadows or imagery to ordinary working records."
    ]
  }
}
