  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Compact familiar action; no custom pressed transform.",
      "html": "<button type=\"button\" class=\"ds-primary\">View projects</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:6px;padding:10px 15px;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:12px;font-weight:550;min-height:38px;white-space:nowrap;cursor:pointer;text-decoration:none;background:var(--teal,#176b77);color:white;}.ds-primary:hover:not(:disabled){background:#115b66;}.ds-primary:disabled{opacity:.48;cursor:not-allowed}.ds-primary:focus-visible{outline:3px solid #2c939d;outline-offset:3px}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Compact familiar action; no custom pressed transform.",
      "html": "<button type=\"button\" class=\"ds-secondary\">Export report</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:6px;padding:10px 15px;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:12px;font-weight:550;min-height:38px;white-space:nowrap;cursor:pointer;text-decoration:none;background:white;color:#3b5067;border-color:#d8e2e9;}.ds-secondary:hover:not(:disabled){background:#edf3f6;border-color:#c6d4df;}.ds-secondary:disabled{opacity:.48;cursor:not-allowed}.ds-secondary:focus-visible{outline:3px solid #2c939d;outline-offset:3px}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Compact teal action, underlined on hover.",
      "html": "<button type=\"button\" class=\"ds-text\">View all <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-text{display:inline-flex;align-items:center;gap:7px;border:0;background:none;color:var(--teal,#176b77);padding:4px 0;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:11px;font-weight:550;text-align:left;cursor:pointer}.ds-text:hover{text-decoration:underline;text-underline-offset:3px}.ds-text:focus-visible{outline:3px solid #2c939d;outline-offset:3px}"
    },
    {
      "name": "Icon button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Named icon-only document view control.",
      "html": "<button type=\"button\" class=\"ds-icon\" aria-label=\"View document\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"7.5\"/><path d=\"m16 16 4 4\"/></svg></button>",
      "css": ".ds-icon{border:0;background:transparent;padding:7px;display:inline-flex;align-items:center;justify-content:center;border-radius:5px;color:#63758b;cursor:pointer}.ds-icon:hover{background:#e9eff4;color:#183b55}.ds-icon:focus-visible{outline:3px solid #2c939d;outline-offset:3px}"
    },
    {
      "name": "Labeled text field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Native field with associated label and final darker placeholder/hint colors.",
      "html": "<div class=\"ds-field\"><label for=\"ds-title\">Research title</label><input class=\"ds-input\" id=\"ds-title\" aria-describedby=\"ds-title-hint\" placeholder=\"Enter a descriptive research title\"><small id=\"ds-title-hint\">Summarize the research topic.</small></div>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;margin-bottom:20px}.ds-field label{font-size:11px;font-weight:600;color:#4f657c}.ds-field small{font-size:10px;line-height:1.7;color:#536b82}.ds-input{width:100%;min-width:0;background:white;border:1px solid #d7e0e8;border-radius:5px;color:#34475f;padding:10px 11px;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:12px;caret-color:var(--teal,#176b77)}.ds-input::placeholder{color:#62758a}.ds-input:hover{border-color:#9fb6c5}.ds-input:focus-visible{outline:3px solid #2c939d;outline-offset:3px}"
    },
    {
      "name": "Document status badges",
      "kind": "chip",
      "refersTo": "status-badge",
      "description": "Noninteractive text tags, not selectable chips; no hover or focus state.",
      "html": "<span class=\"ds-badge ds-approved\">Approved</span> <span class=\"ds-badge ds-pending\">Pending Review</span> <span class=\"ds-badge ds-correction\">Needs Revision</span> <span class=\"ds-badge ds-missing\">Missing</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;border-radius:4px;background:#eef2f6;color:#5d7188;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:9px;font-weight:550;padding:5px 7px;line-height:1.3;white-space:nowrap}.ds-approved{background:#e7f3ed;color:#286c51}.ds-pending{background:#fff3d9;color:#85601c}.ds-correction{background:#fbeceb;color:#a94749}.ds-missing{background:#edf1f6;color:#61748b}"
    },
    {
      "name": "Flat evidence panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Bordered working surface without hover lift.",
      "html": "<section class=\"ds-panel\"><h2>Research by department</h2><p>Project distribution in your authorized scope</p></section>",
      "css": ".ds-panel{background:white;border:1px solid var(--border,#dfe6ed);border-radius:10px;padding:23px;min-width:0;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;color:#233348}.ds-panel h2{font-size:15px;font-weight:650;letter-spacing:-.2px;margin:0 0 19px}.ds-panel p{font-size:10px;line-height:1.65;color:#536b82;margin:-8px 0 23px}@media(max-width:1250px){.ds-panel{padding:19px}}"
    },
    {
      "name": "Navy navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Selected-row preview. React handles destinations and inert closed mobile state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace preview\"><button class=\"ds-nav-item ds-selected\" type=\"button\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z\"/><path d=\"M8 10v6m4-4v4m4-6v6\"/></svg><span>Research projects</span></button><button class=\"ds-nav-item\" type=\"button\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z\"/><path d=\"M8 10v6m4-4v4m4-6v6\"/></svg><span>Research archive</span></button></nav>",
      "css": ".ds-nav{background:var(--nav,#142b46);padding:17px;width:246px;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;}.ds-nav-item{display:flex;gap:12px;align-items:center;width:100%;border:0;background:transparent;color:#c4d3e3;border-radius:6px;padding:11px 13px;text-align:left;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;font-size:12px;margin:3px 0;cursor:pointer;transition:background .15s}.ds-nav-item svg{color:#a7bed4;flex-shrink:0}.ds-nav-item:hover{background:#203b55;color:white}.ds-nav-item.ds-selected{background:#2a465f;color:white}.ds-nav-item.ds-selected svg{color:#91d1d4}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none}}.ds-nav-item:focus-visible{outline:3px solid #2c939d;outline-offset:3px}"
    },
    {
      "name": "Selectable lifecycle path",
      "kind": "custom",
      "refersTo": "lifecycle",
      "description": "Static phase preview; React selects checklist evidence. No snippet runtime is assumed.",
      "html": "<div class=\"ds-lifecycle\"><button class=\"ds-stage ds-current\" type=\"button\"><span class=\"ds-marker\">1</span><span><small>Current phase</small><b>CONCEPTUALIZATION PHASE</b></span></button><button class=\"ds-stage\" type=\"button\"><span class=\"ds-marker\">2</span><span><small>Upcoming phase</small><b>DEVELOPMENT PHASE</b></span></button><button class=\"ds-stage\" type=\"button\"><span class=\"ds-marker\">3</span><span><small>Upcoming phase</small><b>IMPLEMENTATION PHASE</b></span></button></div>",
      "css": ".ds-lifecycle{display:flex;background:white;border:1px solid var(--border,#dfe6ed);border-radius:9px;overflow:hidden;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;}.ds-stage{flex:1;min-width:0;display:flex;align-items:center;gap:12px;border:0;border-right:1px solid var(--border,#dfe6ed);background:white;color:#233348;padding:20px 19px;text-align:left;font-family:\"Segoe UI\",-apple-system,BlinkMacSystemFont,Arial,sans-serif;cursor:pointer}.ds-stage:last-child{border-right:0}.ds-stage.ds-current{background:#edf5f6}.ds-stage:hover{background:#f1f6f8}.ds-marker{display:flex;align-items:center;justify-content:center;border:1px solid #d6e0e8;width:32px;height:32px;border-radius:50%;color:#536b82;flex-shrink:0;font-size:13px}.ds-current .ds-marker{background:#206c79;color:white;border-color:transparent}.ds-stage small{font-size:9px;color:#536b82}.ds-stage b{font-size:10px;line-height:1.6;display:block;margin-top:5px}@media(max-width:1250px){.ds-stage{padding:17px 12px;gap:9px}.ds-stage b{font-size:9px}}@media(max-width:1000px){.ds-stage{flex-direction:column;align-items:flex-start}.ds-stage small{font-size:8px}}@media(max-width:760px){.ds-stage{padding:15px 10px}.ds-stage b{font-size:8px}.ds-marker{width:27px;height:27px;font-size:11px}}.ds-stage:focus-visible{outline:3px solid #2c939d;outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Research wayfinding",
    "overview": "Make the next research action evident without hiding the documentary evidence. The built interface is a calm, dense operations workspace: a navy navigation shell anchors white working surfaces on a cool near-white ground; teal identifies actions and progress. Familiar buttons, selects, tables, tabs, and dialogs support web operate mode rather than a novel interaction model.\n\nThis is the user-approved provisional world, not official BukSU/RDU branding. No official university color values, logo, or fonts were supplied. The RDMS wordmark and folder line icon are prototype identity. There are no shipped raster design assets; the screenshots are evidence only, not interface imagery.",
    "keyCharacteristics": [
      "Persistent wayfinding with a compact identity bar and grouped navigation.",
      "Aligned, information-dense records with restrained teal actions.",
      "Ordered lifecycle evidence with explicit review and locked-phase states.",
      "Flat bordered surfaces, small rounded controls, and system typography."
    ],
    "rules": [
      {
        "name": "The Evidence State Rule",
        "body": "Keep status wording visible alongside color; an uploaded document is not an approved document.",
        "section": "colors"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Reserve shadows for dialogs and toasts; separate working surfaces with tone and borders.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve navy wayfinding, white work surfaces, and restrained teal actions.",
      "**Do** use the final darker secondary-text and placeholder overrides when reproducing the interface.",
      "**Do** keep status wording, version metadata, and locked/ready phase explanations visible.",
      "**Do** retain native controls, visible keyboard focus, reduced-motion support, and inert closed mobile navigation.",
      "**Do** label demo identities, synthetic evidence, provisional branding, and unavailable integrations honestly.",
      "**Don't** present this palette, system font stack, or folder wordmark as official BukSU/RDU identity.",
      "**Don't** add decorative raster imagery or reuse evidence screenshots as shipped UI assets.",
      "**Don't** replace familiar operate-mode controls with custom experimental interaction patterns.",
      "**Don't** equate upload completion with approval, or monitoring with authority to review.",
      "**Don't** add shadows to routine cards or invent unimplemented mobile/dialog accessibility behavior."
    ],
    "donts": [
      "**Don't** present this palette, system font stack, or folder wordmark as official BukSU/RDU identity.",
      "**Don't** add decorative raster imagery or reuse evidence screenshots as shipped UI assets.",
      "**Don't** replace familiar operate-mode controls with custom experimental interaction patterns.",
      "**Don't** equate upload completion with approval, or monitoring with authority to review.",
      "**Don't** add shadows to routine cards or invent unimplemented mobile/dialog accessibility behavior."
    ]
  }
